# Preferred server-side rewrite target. Set this in Vercel for Preview and
# Production to the deployed Express backend origin, with no trailing slash.
# The existing NEXT_PUBLIC_API_URL is also accepted during migration, but new
# deployments should keep the URL server-side: the browser uses same-origin
# proxy routes.
SERVER_API_URL=

# Local development: copy .env.local.example to .env.local.
# Backend secrets and MongoDB credentials belong only in the backend project.
